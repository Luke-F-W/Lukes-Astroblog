---
import Layout from '../layouts/BlogPost.astro';
---
<Layout
  title="Lobbying Record Search | Civie.ie"
  description="Search lobbying records on Civie.ie."
  pubDate={new Date('2026-01-01')}
>
  <link rel="stylesheet" href="/css/indexrecords.css" />
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=search"
  />

  <div class="searchpanel">
    <form>
      <div class="searchbar">
        <span class="material-symbols-outlined">search</span>
        <input class="searchbar-input" type="text" id="search-input" placeholder="Search..." />
      </div>

      <div class="searchbar">
        <span>Before:</span>
        <input type="date" id="before-input" />
      </div>

      <div class="searchbar">
        <span>After:</span>
        <input type="date" id="after-input" />
      </div>

      <div class="center-bottom">
        <button type="button" class="btnsearch" id="btn-prev">&lt;</button>
        <p>Page Number: <span id="page-display">1</span></p>
        <button type="button" class="btnsearch" id="btn-next">&gt;</button>
      </div>

      <button type="button" class="btnsearch" id="btn-search">Search</button>

      <p class="data-attribution">
        Lobbying data is sourced from the Register of Lobbying, maintained by
        the Standards Commission. Visit
        <a href="https://www.lobbying.ie/">Lobbying.ie</a>.
      </p>
    </form>
  </div>

  <div class="resultspanel"></div>

<script>
  let currentPage = 1;
  let lobbying = [];

  const searchInput = document.getElementById('search-input');
  const beforeInput = document.getElementById('before-input');
  const afterInput = document.getElementById('after-input');
  const pageDisplay = document.getElementById('page-display');
  const resultsPanel = document.querySelector('.resultspanel');
  const prevButton = document.getElementById('btn-prev');
  const nextButton = document.getElementById('btn-next');
  const searchButton = document.getElementById('btn-search');

  async function runSearch() {
    const before = beforeInput.value || '2300-01-01';
    const after = afterInput.value || '1900-01-01';

    let url = `https://api.civie.ie/API/sector/lobby?page=${currentPage}`;
    if (searchInput.value) url += `&q=${encodeURIComponent(searchInput.value)}`;
    url += `&after=${after}&before=${before}`;

    // Lock all buttons while we wait for the results
    prevButton.disabled = true;
    nextButton.disabled = true;
    searchButton.disabled = true;

    pageDisplay.textContent = currentPage;
    showSkeleton();

    try {
      const jsondata = await fetch(url).then(res => res.json());
      showResults(jsondata);

      // Unlock the buttons now that results are on screen
      const totalPages = Math.ceil(jsondata.records / jsondata.pagesize);
      prevButton.disabled = currentPage <= 1;
      nextButton.disabled = currentPage >= totalPages;
    } catch (error) {
      resultsPanel.innerHTML = '<p style="margin: 8px 16px;">Something went wrong. Please try again.</p>';
    }

    // Search is always unlocked at the end, even if the request failed
    searchButton.disabled = false;
  }

  function showResults(jsondata) {
    lobbying = jsondata.data;

    resultsPanel.innerHTML = `
      <p style="margin: 8px 16px;">${jsondata.records} results found</p>
      ${lobbying.map((obj, index) => `
        <div class="billrecord" data-index="${index}">
          <h2>Details: ${obj['Specific Details'] || 'Nil Return'}</h2>
          <p>Lobbied: ${parseNames(obj['DPOs Lobbied']) || 'Nil Return'}</p>
          <div>${memberImages(obj)}</div>
          <p>Lobbyist: ${obj['Lobbyist Name'] || ''}</p>
          <p>
            Date: ${obj['Date Published'] || ''}
            | Person primarily doing the lobbying:
            ${obj['Person primarily responsible for lobbying on this activity'] || 'Nil Return'}
          </p>
        </div>
      `).join('')}
    `;

    resultsPanel.querySelectorAll('.billrecord').forEach(card => {
      card.addEventListener('click', () => openLobby(Number(card.dataset.index)));
    });
  }

  function openLobby(index) {
    sessionStorage.setItem('selectedLobby', JSON.stringify(lobbying[index]));
    window.location.href = '/lobbyview';
  }

  function showSkeleton() {
    resultsPanel.innerHTML = Array(10).fill(`
      <div class="skeletonbillrecord">
        <div class="skeleton-title"></div>
        <div class="skeleton-p"></div>
        <div class="skeleton-p"></div>
        <div class="skeleton-p"></div>
        <div class="skeleton-p"></div>
        <div class="skeleton-p"></div>
        <div class="skeleton-shorts">
          <div class="skeleton-short"></div>
          <div class="skeleton-short"></div>
          <div class="skeleton-short"></div>
        </div>
      </div>
    `).join('');
  }

  function parseNames(str) {
    if (!str) return '';
    return str.split('::').map(entry => entry.split('|')[0]).join(', ');
  }

  function memberImages(obj) {
    return (obj['MemberCodes'] ?? '').split('|').filter(Boolean).map(code => `
      <img
        class="sponsor-img"
        src="https://data.oireachtas.ie/ie/oireachtas/member/id/${encodeURIComponent(code)}/image/thumb"
        alt="${code}"
        loading="lazy"
      >
    `).join('');
  }

  searchButton.addEventListener('click', () => {
    currentPage = 1;
    runSearch();
  });

  prevButton.addEventListener('click', () => {
    currentPage--;
    runSearch();
  });

  nextButton.addEventListener('click', () => {
    currentPage++;
    runSearch();
  });

  // Load the first page when the site opens
  runSearch();
</script>
</Layout>